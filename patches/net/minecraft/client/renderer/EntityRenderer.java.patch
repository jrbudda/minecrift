+    
+    private void restoreRVEPos(){
+        if (mc.renderViewEntity == null) return;
+        mc.renderViewEntity.posX = rveX;
+        mc.renderViewEntity.posY = rveY;
+        mc.renderViewEntity.posZ = rveZ;
+        mc.renderViewEntity.lastTickPosX = rvelastX;
+        mc.renderViewEntity.lastTickPosY = rvelastY;
+        mc.renderViewEntity.lastTickPosZ = rvelastZ;
+        mc.renderViewEntity.prevPosX = rveprevX;
+        mc.renderViewEntity.prevPosY = rveprevY;
+        mc.renderViewEntity.prevPosZ = rveprevZ;
+        cached = false;
+    }
