+    private float angleDiff(float a, float b) {
+        float d = Math.abs(a - b) % 360;
+        float r = d > 180 ? 360 - d : d;
+        
+        int sign = (a - b >= 0 && a - b <= 180) || (a - b <=-180 && a- b>= -360) ? 1 : -1;
+        return r * sign;
+    }
